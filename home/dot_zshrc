# XDG Base Directory Specification
export XDG_CONFIG_HOME=${ZDOTDIR:-$HOME}/.config
export XDG_CACHE_HOME=${ZDOTDIR:-$HOME}/.cache
export XDG_DATA_HOME=${ZDOTDIR:-$HOME}/.local/share

# load exports, aliases, and functions
source "$XDG_CONFIG_HOME/zsh/exports.zsh"
source "$XDG_CONFIG_HOME/zsh/aliases.zsh"
source "$XDG_CONFIG_HOME/zsh/functions.zsh"

# zap plugin manager
[ -f "${XDG_DATA_HOME}/zap/zap.zsh" ] && source "${XDG_DATA_HOME}/zap/zap.zsh"
plug "zsh-users/zsh-autosuggestions"
plug "zsh-users/zsh-syntax-highlighting"

# completions
## place completion functions in $HOME/.local/share/zsh/site-functions
fpath=("$HOME/.local/share/zsh/site-functions" $fpath)
autoload -Uz compinit
# remove the zcompdump file if it is older than 24 hours (need extendedglob option)
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
    compinit
else
    compinit -C
fi

# menu select
zstyle ':completion:*' menu select
#zstyle ':completion::complete:lsof:*' menu yes select # for lsof command completion
zmodload zsh/complist
#_comp_options+=(globdots) # Include hidden files.
## use vim-like style to select menu
bindkey -M menuselect 'h' vi-backward-char
bindkey -M menuselect 'j' vi-down-line-or-history
bindkey -M menuselect 'k' vi-up-line-or-history
bindkey -M menuselect 'l' vi-forward-char

# keybinds
bindkey -v # use vi mode
(( $+commands[yazi] )) && bindkey -s "^Y" 'ya^M' #yazi
bindkey ',' autosuggest-accept # zsh-autosuggestions
# fzf
[[ -f $XDG_CONFIG_HOME/fzf/fzf.zsh ]] && source $XDG_CONFIG_HOME/fzf/fzf.zsh #fzf must be installed in $HOME/.local/src/

# colors
#autoload -Uz colors && colors

(( $+commands[atuin] ))  && eval "$(atuin init zsh --disable-up-arrow)" #atuin SQLite shell history
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)" #zoxide
#starship, should be the last line of .zshrc
(( $+commands[starship] )) && eval "$(starship init zsh)"
